# ---------------------------------------------------------------------------
# Copy to .env and edit before running `docker compose up`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=transit
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=transit
# Host port the database is published on. Comment out the `ports:` block on
# the db service in production to keep it internal to the compose network.
POSTGRES_PORT=5432

# --- Backend --------------------------------------------------------------
# MUST be changed. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=insecure-development-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
LOG_LEVEL=INFO

# Bootstrap administrator, created on first startup only.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me-too
FIRST_ADMIN_EMAIL=admin@example.com

# Insert a small demo network (a few stops, one line, one board) on an empty
# database so the UI is not blank on first login. Set to false for real use.
SEED_DEMO_DATA=true

# NOTE: the instance name shown in the sidebar, on the login page and in the
# browser tab is NOT set here. It is the `instance_name` row on the Settings
# page, so it can be changed without a redeploy. APP_NAME below is only the
# fallback used for the moments before that row exists.
# APP_NAME=Transit Scheduling

# --- Frontend / map -------------------------------------------------------
# Point this at an internal tile server if the host has no internet access.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
MAP_DEFAULT_LAT=52.3676
MAP_DEFAULT_LON=4.9041
MAP_DEFAULT_ZOOM=12

# --- Web ------------------------------------------------------------------
# Port the whole application is served on.
WEB_PORT=8080
